FLASK_CONFIG=development
PORT=5001
SECRET_KEY=replace-with-a-local-secret
CALGARY_DEVELOPER_TOKEN=
# Optional; City outlines work without Overpass:
ENABLE_OSM_ENRICHMENT=false
# Enable after installing requirements-llm.txt:
ENABLE_LOCAL_LLM=false
# Defaults to sqlite:///urban_dashboard.db:
# DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:3006,http://127.0.0.1:3006
